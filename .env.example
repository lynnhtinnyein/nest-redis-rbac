PORT=8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=

# JWT (generate secrets with: openssl rand -hex 32)
JWT_SECRET=
# seconds (900 = 15 mins)
JWT_EXPIRES_IN=900

JWT_REFRESH_SECRET=
# seconds (604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800

# Seed (first SUPER_ADMIN, used by yarn seed)
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379